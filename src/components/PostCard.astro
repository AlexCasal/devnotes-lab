---
import { categorySlug, formatDate, postUrl, readingTime } from '../lib/posts';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const minutes = readingTime(post.body);
---

<article class="rounded-xl border border-cyan-300/15 bg-[#10111f]/85 p-5 shadow-2xl shadow-black/20 transition hover:-translate-y-0.5 hover:border-cyan-300/35 hover:shadow-cyan-950/30">
  <div class="mb-4 flex flex-wrap items-center gap-2 text-xs text-slate-400">
    <a class="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-2.5 py-1 text-cyan-100" href={`/categories/${categorySlug(post.data.category)}/`}>
      {post.data.category}
    </a>
    <span>{formatDate(post.data.date)}</span>
    <span>{minutes} min read</span>
    <span class="rounded-full border border-fuchsia-300/25 bg-fuchsia-300/10 px-2 py-0.5 capitalize text-fuchsia-100">{post.data.level}</span>
  </div>

  <h2 class="text-xl font-semibold leading-tight text-white">
    <a href={postUrl(post)}>{post.data.title}</a>
  </h2>
  <p class="mt-3 text-sm leading-6 text-slate-300">{post.data.description}</p>

  <div class="mt-5 flex flex-wrap items-center gap-2 text-xs text-slate-400">
    <span>By {post.data.author}</span>
    <span class="text-slate-600">/</span>
    {post.data.tags.map((tag) => (
      <span class="rounded-md bg-violet-300/10 px-2 py-1 text-violet-100">#{tag}</span>
    ))}
  </div>
</article>
